{
  "name": "todo-app",
  "launch": {
    "command": "node server.mjs 4599",
    "cwd": ".",
    "readyLog": "listening on",
    "timeoutMs": 15000
  },
  "baseUrl": "http://127.0.0.1:4599",
  "viewport": { "width": 1280, "height": 720 },
  "review": {
    "ignoreConsole": [],
    "ignoreNetwork": ["404 GET .*/favicon\\.ico"]
  },
  "scenario": [
    { "action": "goto", "url": "/" },
    { "action": "fill", "selector": "#new-todo", "value": "Write the demo skill" },
    { "action": "click", "selector": "#add-btn" },
    { "action": "fill", "selector": "#new-todo", "value": "Record a real video" },
    { "action": "click", "selector": "#add-btn" },
    { "action": "expectText", "selector": "#count", "text": "2 remaining" },
    { "action": "click", "selector": "#todo-list li:first-child .toggle" },
    { "action": "expectText", "selector": "#count", "text": "1 remaining" },
    { "action": "expectVisible", "selector": "#todo-list li.done" },
    { "action": "snapshot", "label": "final-state" }
  ]
}
